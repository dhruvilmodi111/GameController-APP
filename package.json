{
  "name": "gyro-play-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=@gyro-play/server",
    "dev:client": "npm run dev --workspace=@gyro-play/client",
    "build": "npm run build --workspace=@gyro-play/server && npm run build --workspace=@gyro-play/client",
    "build:server": "npm run build --workspace=@gyro-play/server",
    "build:client": "npm run build --workspace=@gyro-play/client",
    "start": "npm run start --workspace=@gyro-play/server",
    "test": "node tests/test-pairing-system.mjs && node tests/test-mobile-app.mjs",
    "test:pairing": "node tests/test-pairing-system.mjs",
    "test:mobile": "node tests/test-mobile-app.mjs",
    "mobile:start": "npm start --prefix mobile",
    "mobile:build": "bash -c 'JAVA_HOME=/home/dhruvil-modi/.jdk-17 ANDROID_HOME=/home/dhruvil-modi/Android/Sdk cd mobile/android && ./gradlew assembleDebug'",
    "adb:reverse": "/home/dhruvil-modi/Android/Sdk/platform-tools/adb reverse tcp:3001 tcp:3001 && /home/dhruvil-modi/Android/Sdk/platform-tools/adb reverse tcp:5173 tcp:5173",
    "ip": "ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \\K\\S+' || hostname -I | awk '{print $1}'"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
